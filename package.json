{
  "name": "tiptap-extension-resize-image",
  "version": "1.5.1",
  "type": "module",
  "description": "A tiptap image resizing extension for React, Vue, Next, and VanillaJS. Additionally, it can align the image position.",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./esm/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bae-sh/tiptap-extension-resize-image.git"
  },
  "scripts": {
    "build": "yarn clean && yarn build:tsc && yarn build:rollup",
    "build:tsc": "yarn tsc --declaration --emitDeclarationOnly --declarationDir dist",
    "build:rollup": "rollup -c rollup.config.mjs",
    "clean": "rm -rf dist esm",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "bae-sh <hyeon1293@gmail.com>",
  "contributors": [
    {
      "name": "dongyounyim",
      "email": "dyyim4725@gmail.com"
    }
  ],
  "directories": {
    "lib": "lib"
  },
  "license": "MIT",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "image",
    "resize-image",
    "resizable image",
    "align image"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-document": "^3.22.5",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-paragraph": "^3.22.5",
    "@tiptap/extension-text": "^3.22.5",
    "@tiptap/pm": "^3.34.0",
    "@types/node": "^22",
    "jsdom": "^31.0.1",
    "prettier": "^3.3.3",
    "rollup": "^4.8.0",
    "tslib": "^2.6.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0 || ^3.0.0",
    "@tiptap/extension-image": "^2.0.0 || ^3.0.0",
    "@tiptap/pm": "^2.0.0 || ^3.0.0"
  }
}
